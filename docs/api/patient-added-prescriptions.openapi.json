{
  "openapi": "3.1.0",
  "info": {
    "title": "ML-140 patient-added prescription confirmation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/prescriptions/{prescription_id}/confirm": {
      "post": {
        "tags": [
          "Prescriptions"
        ],
        "summary": "Confirm patient-added draft for personal use",
        "description": "After reviewing the saved items, the owning patient explicitly confirms the draft. No body or query parameters. Source remains patient and confirmation does not grant clinical verification or dispensing permission.",
        "operationId": "medilink_048",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "prescription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Prescription Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrescriptionDetail"
                }
              }
            }
          },
          "400": {
            "description": "Request body is not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current patient role required or forbidden source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Prescription absent or concealed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Invalid prescription state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid saved items, references or query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Authenticated request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Request quota store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicalWriteErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
