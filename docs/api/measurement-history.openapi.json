{
  "openapi": "3.1.0",
  "info": {
    "title": "MediLink measurement history",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/patients/{patient_id}/measurements/history": {
      "get": {
        "tags": [
          "Measurements"
        ],
        "summary": "List Measurement History",
        "operationId": "listPatientMeasurementHistory",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementsReadPage"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field_errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Field Errors"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "field_errors",
          "request_id"
        ],
        "title": "Error"
      },
      "MeasurementsRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "patient_user_id": {
            "type": "string",
            "format": "uuid",
            "title": "Patient User Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "weight",
              "blood_pressure",
              "blood_glucose"
            ],
            "title": "Type"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "secondary_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secondary Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "kg",
              "lb",
              "mmol/L",
              "mg/dL",
              "mmHg"
            ],
            "title": "Unit"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At"
          },
          "recorded_by": {
            "type": "string",
            "format": "uuid",
            "title": "Recorded By"
          },
          "source": {
            "type": "string",
            "enum": [
              "patient",
              "doctor",
              "pharmacist",
              "lab_staff",
              "approved_external_system",
              "admin"
            ],
            "title": "Source"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "entered_in_error"
            ],
            "title": "Status"
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "correction_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correction Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_user_id",
          "type",
          "value",
          "secondary_value",
          "unit",
          "measured_at",
          "recorded_by",
          "source",
          "notes",
          "status",
          "supersedes_id",
          "correction_reason",
          "created_at"
        ],
        "title": "MeasurementsRead"
      },
      "MeasurementsReadPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MeasurementsRead"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "MeasurementsReadPage"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
