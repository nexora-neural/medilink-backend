APP_NAME=MediLink API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Exact browser origins allowed to call the API; configure a JSON array.
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL connection settings (use your local PostgreSQL account)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medilink
DB_USER=your_local_db_user
DB_PASSWORD=replace_with_your_local_db_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Firebase Admin SDK uses Application Default Credentials.
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to a local service-account file path.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Firebase Web API key used by the local-only test-account seeder.
FIREBASE_WEB_API_KEY=

# Local private file storage; keep uploaded clinical files outside public/static folders.
PRIVATE_UPLOAD_DIR=./data/private_uploads

# Shared PostgreSQL request limits (development/demo defaults)
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_RESOLUTION_PER_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_RESOLUTION_PER_IP_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_ACCOUNT_PER_HOUR=20
RATE_LIMIT_INTEGRATION_PER_CLIENT_PER_MINUTE=60
